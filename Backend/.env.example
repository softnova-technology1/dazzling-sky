# ===============================================
# DAZZLING SKY — BACKEND ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your credentials
# ===============================================

# Port where Express server listens
PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dazzling-sky?retryWrites=true&w=majority

# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=your_super_secret_jwt_key_here

# Gmail credentials for sending luxury order confirmation receipts
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password

# Allowed Frontend URL for CORS security
CLIENT_URL=http://localhost:3000

# One-time bootstrap key to protect admin initialization
ADMIN_SETUP_SECRET=dazzling_sky_secret_setup_key_2026
